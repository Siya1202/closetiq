DATABASE_URL="postgresql://user:password@localhost:5432/closetiq"
JWT_SECRET="your-jwt-secret-change-in-production"
OPENROUTER_API_KEY="your-openrouter-key"
PORT=4000

# Frontend URL — lock CORS to this origin in production.
# Leave unset in local dev to allow all origins (*).
FRONTEND_URL="http://localhost:3000"

# Next.js public env — used by the web app to reach the API
NEXT_PUBLIC_API_URL="http://localhost:4000"