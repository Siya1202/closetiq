DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/closetiq?sslmode=require&pgbouncer=true"
# Direct (non-pooled) connection — used by Prisma for migrations. Get from Neon dashboard.
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/closetiq?sslmode=require"
JWT_SECRET="your-jwt-secret-change-in-production"
OPENROUTER_API_KEY="your-openrouter-key"

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
PORT=4000

# Frontend URL — lock CORS to this origin in production.
# Leave unset in local dev to allow all origins (*).
FRONTEND_URL="http://localhost:3000"
# Swagger Documentation (Optional, used for Basic Auth in production)
API_DOCS_USER="admin"
API_DOCS_PASSWORD="your-secure-password"
# Next.js public env — used by the web app to reach the API
NEXT_PUBLIC_API_URL="http://localhost:4000"